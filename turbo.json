{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "HTTP_PORT",
    "DATABASE_URL",
    "BASE_URL",
    "ADMIN_MAIL",
    "OWNER_EMAILS",
    "FILES_DIR",
    "LOG_LEVEL",
    "LOG_FORMAT",
    "OTLP_URL",
    "NG_ALLOWED_HOSTS",
    "NG_TRUST_PROXY_HEADERS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".angular/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": []
    },
    "test:features": {
      "dependsOn": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
