    "@structure-ai/auth-sqlite": "0.0.6",
    "@structure-ai/authorization": "0.0.6",
    "@structure-ai/cli": "0.0.6",
    "@structure-ai/config": "0.0.6",
    "@structure-ai/cqrs": "0.0.6",
    "@structure-ai/domain": "0.0.6",
    "@structure-ai/eventsourcing": "0.0.6",
    "@structure-ai/eventsourcing-pg": "0.0.6",
    "@structure-ai/eventsourcing-sqlite": "0.0.6",
    "@structure-ai/http": "0.0.6",
    "@structure-ai/mcp": "0.0.6",
    "@structure-ai/migrations": "0.0.6",
    "@structure-ai/observability": "0.0.6",
