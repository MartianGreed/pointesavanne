{
  "default": {
    "paths": [
      "test/features/**/*.feature"
    ],
    "requireModule": [],
    "require": [
      "test/features/step-definitions/**/*.ts",
      "test/features/support/**/*.ts"
    ],
    "format": [
      "progress-bar",
      "html:reports/cucumber-report.html"
    ],
    "formatOptions": {
