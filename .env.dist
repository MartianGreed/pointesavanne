# Postgres connection (docker-compose up provides postgres://pointesavanne:pointesavanne@localhost:5432/pointesavanne)
DATABASE_URL=postgres://pointesavanne:pointesavanne@localhost:5432/pointesavanne

# HTTP server
HTTP_PORT=3000

# Emails owning the "owner" role (comma-separated)
OWNER_EMAILS=valentin.dosimont@gmail.com

# Villa admin mailbox for internal notifications
ADMIN_MAIL=valentin.dosimont@gmail.com

# Observability (see apps/api README for the full table)
LOG_LEVEL=info
LOG_FORMAT=pretty
